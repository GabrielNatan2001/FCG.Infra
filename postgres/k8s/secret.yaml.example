# Exemplo — NÃO contém credenciais reais.
# Aplique secrets com:  ..\..\FCG.Infra\scripts\apply-secrets.ps1
# (ou copie para secret.local.yaml e aplique localmente; secret.local.yaml está no .gitignore)
apiVersion: v1
kind: Secret
metadata:
  name: fcg-postgres-secret
type: Opaque
stringData:
  POSTGRES_USER: "<USER>"
  POSTGRES_PASSWORD: "<PASSWORD>"
